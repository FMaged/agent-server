# Managed by Ansible.
[Unit]
Description=llama.cpp server
After=network-online.target
Wants=network-online.target

[Service]
User=llama
Group=llama
ExecStart={{ llm_src_dir }}/build/bin/llama-server \
  --host {{ llm_bind }} --port {{ llm_port }} \
  --model {{ llm_models_dir }}/{{ llm_models[llm_model].file }} \
  --api-key-file {{ llm_key_file }} \
  --jinja -t {{ llm_threads }} -c {{ llm_ctx }}
Restart=on-failure

[Install]
WantedBy=multi-user.target
