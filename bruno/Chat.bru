meta {
  name: Chat
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "model": "x",
    "messages": [{"role": "user", "content": "Say hi"}],
    "max_tokens": 200
  }
}

assert {
  res.status: eq 200
}
